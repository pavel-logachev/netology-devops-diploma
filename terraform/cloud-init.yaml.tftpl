#cloud-config
users:
  - name: ${ssh_user}
    groups: [sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}
ssh_pwauth: false
disable_root: true
package_update: false
runcmd:
  # В Ubuntu 24.04 sshd запускается через socket activation; обычная служба
  # предсказуемее для bastion и цепочек ProxyJump.
  - [systemctl, disable, --now, ssh.socket]
  - [systemctl, enable, --now, ssh.service]
