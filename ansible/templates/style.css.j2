body { font-family: system-ui, sans-serif; background: #f4f6f8; color: #1d2733; margin: 0; }
main { max-width: 720px; margin: 10vh auto; padding: 2rem; background: #fff; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.08); }
.node { font-size: 1.2rem; padding: .8rem 1rem; background: #e8f1ff; border-radius: 8px; }
