global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: node
    static_configs:
{% for host in groups['web'] %}
      - targets: ["{{ hostvars[host].private_ip }}:9100"]
        labels: { host: "{{ host }}" }
{% endfor %}

  - job_name: nginxlog
    static_configs:
{% for host in groups['web'] %}
      - targets: ["{{ hostvars[host].private_ip }}:4040"]
        labels: { host: "{{ host }}" }
{% endfor %}
